{
  "name": "deskpet",
  "productName": "DeskPet",
  "version": "1.1.0",
  "description": "A desktop pet that reacts to you and your AI agents",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "snapshot": "electron . --snapshot",
    "package:win": "electron-packager . DeskPet --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --ignore=^/dist --ignore=^/test-output",
    "package:mac": "electron-packager . DeskPet --platform=darwin --arch=arm64 --out=dist --overwrite --ignore=^/dist --ignore=^/test-output",
    "package:linux": "electron-builder --linux AppImage tar.gz --x64 --arm64"
  },
  "private": true,
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "jacobsekai",
    "email": "jacobalhaboby@gmail.com"
  },
  "homepage": "https://github.com/jacobsekai/deskpet",
  "build": {
    "appId": "local.deskpet",
    "productName": "DeskPet",
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "DeskPet-linux-${arch}.${ext}",
      "synopsis": "A desktop pet that keeps an eye on your AI agents",
      "executableName": "deskpet"
    },
    "publish": null
  }
}
